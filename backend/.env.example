# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=smartdevagents_workspace

# AI Provider
AI_PROVIDER=openrouter

# OpenRouter - preferred provider (use openrouter/free for the free model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SmartDevAgents

# Gemini API - optional secondary provider, Project 1
GEMINI_API_KEY_1=
GEMINI_MODEL_1=gemini-3.8-flash

# Gemini API - optional secondary provider, Project 2
GEMINI_API_KEY_2=
GEMINI_MODEL_2=gemini-3.8-flash

# Optional GitHub integration - added later
# GITHUB_TOKEN=
# GITHUB_USERNAME=
# Developer quality gate: build generated frontend before saving it
DEVELOPER_RUN_BUILD_GATE=true
